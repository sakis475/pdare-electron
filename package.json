{
  "name": "electron-ts-app",
  "description": "Food and Beverage Ordering Printer App",
  "version": "1.0.0",
  "main": "dist/src/main/main.js",
  "homepage": "https://your-website.com",
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com"
  },
  "build": {
    "appId": "your.app.id",
    "productName": "Serve Tab Printer Service",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/servetablogopurple.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/servetablogopurple.png",
      "category": "Utility"
    },
    "asar": true
  },
  "scripts": {
    "clean": "rimraf dist",
    "start": "electron .",
    "build": "npm run clean && tsc && webpack --config webpack.config.js",
    "start:prod": "npm run clean && npm run build && npm run start",
    "build:win": "npm run build && npx electron-builder --win",
    "build:linux": "npm run build && npx electron-builder --linux",
    "generate-update": "node scripts/generate-update.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "electron-store": "^8.1.0",
    "node-thermal-printer": "^4.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.2.2",
    "css-loader": "^6.11.0",
    "electron": "^29.0.0",
    "electron-builder": "^25.1.8",
    "html-webpack-plugin": "^5.6.3",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  },
  "nodemonConfig": {
    "watch": [
      "dist/src/main",
      "dist/renderer/*"
    ],
    "ignore": [],
    "delay": "100"
  }
}
